# Clerk application keys. Configure the production values in Vercel.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Public origin of the deployed Cloudflare Worker API, without a trailing slash.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Server-only CloudFlare ImgBed upload settings. Never prefix the token with
# NEXT_PUBLIC_. CFBED_BASE_URL is your own ImgBed site, not its docs site.
CFBED_BASE_URL=https://file.vacu.top
CFBED_API_TOKEN=imgbed_dc2d8cc4df18fa7e3fac58495cda3f045494494be983caa47d69dd566b306a17
CFBED_UPLOAD_FOLDER=moments
