# Clerk：Publishable Key 可公开，Secret Key 只能在服务端使用。
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Cloudflare Worker API 后端地址
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# CloudFlare ImgBed 上传服务：填写图床地址和 upload 权限 Token。
# Token 只能在服务端使用，禁止添加 NEXT_PUBLIC_ 前缀。
CFBED_BASE_URL=https://file.example.com
CFBED_API_TOKEN=replace-with-an-imgbed-token-that-has-upload-permission
# 图片上传到的路径
CFBED_UPLOAD_FOLDER=moments
