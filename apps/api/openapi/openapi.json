{
  "openapi": "3.1.0",
  "info": {
    "title": "Moments API",
    "version": "2.0.0",
    "description": "Public read and Clerk-protected write API for a personal Moments site. v2 merges date reads into GET /posts (?date=) and serves statistics from incremental aggregates."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "Service metadata and health."
    },
    {
      "name": "Posts",
      "description": "Public post reads (feed, date mode, random) and administrator mutations."
    },
    {
      "name": "Statistics",
      "description": "Aggregated posting statistics and administrator maintenance."
    },
    {
      "name": "Trash",
      "description": "Administrator recycle bin management."
    },
    {
      "name": "Authentication",
      "description": "Clerk session and administrator status."
    }
  ],
  "components": {
    "securitySchemes": {
      "ClerkBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Clerk session JWT",
        "description": "Clerk session token returned by getToken()."
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "database": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "status",
          "database",
          "timestamp"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "message"
                  ]
                }
              }
            },
            "required": [
              "code",
              "message"
            ]
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "error",
          "requestId"
        ]
      },
      "PostList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Post"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Present only in date mode (?date=...): the requested Asia/Shanghai date.",
            "example": "2026-08-07"
          },
          "navigation": {
            "type": "object",
            "properties": {
              "newerDate": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "Calendar date in the fixed Asia/Shanghai time zone.",
                "example": "2026-08-07"
              },
              "olderDate": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "Calendar date in the fixed Asia/Shanghai time zone.",
                "example": "2026-08-07"
              }
            },
            "required": [
              "newerDate",
              "olderDate"
            ],
            "description": "Present only in date mode (?date=...): adjacent dates that have posts."
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "Post": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Stable post ID.",
            "example": "b3d4da0e-9d8d-43ee-a6a2-c0139814d59e"
          },
          "content": {
            "type": "string",
            "example": "今天完成了 Moments API。"
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "description": "Ordered image URLs attached to this post.",
            "example": [
              "https://file.example.com/file/example.jpg"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "edited": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "content",
          "images",
          "createdAt",
          "updatedAt",
          "edited"
        ]
      },
      "MomentStatistics": {
        "type": "object",
        "properties": {
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DailyMomentCount"
            }
          },
          "administratorNarrative": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NarrativeParagraph"
            }
          }
        },
        "required": [
          "days",
          "administratorNarrative"
        ]
      },
      "DailyMomentCount": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Calendar date in the fixed Asia/Shanghai time zone.",
            "example": "2026-08-07"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "date",
          "count"
        ]
      },
      "NarrativeParagraph": {
        "type": "object",
        "properties": {
          "segments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NarrativeSegment"
            },
            "minItems": 1
          }
        },
        "required": [
          "segments"
        ]
      },
      "NarrativeSegment": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "bold": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "text"
        ]
      },
      "PostDetail": {
        "type": "object",
        "properties": {
          "post": {
            "$ref": "#/components/schemas/Post"
          },
          "navigation": {
            "type": "object",
            "properties": {
              "newerId": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uuid",
                "description": "Stable post ID.",
                "example": "b3d4da0e-9d8d-43ee-a6a2-c0139814d59e"
              },
              "olderId": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uuid",
                "description": "Stable post ID.",
                "example": "b3d4da0e-9d8d-43ee-a6a2-c0139814d59e"
              }
            },
            "required": [
              "newerId",
              "olderId"
            ]
          }
        },
        "required": [
          "post",
          "navigation"
        ]
      },
      "WritePost": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "default": "",
            "description": "Plain text. Consecutive spaces, tabs and line breaks are normalized before storage."
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "maxItems": 18,
            "default": [],
            "description": "Ordered image URLs, at most 18. Text or at least one image is required."
          }
        },
        "additionalProperties": false
      },
      "DeletedPostList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeletedPost"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "DeletedPost": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Post"
          },
          {
            "type": "object",
            "properties": {
              "deletedAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "deletedAt"
            ]
          }
        ]
      },
      "AuthStatus": {
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "isAdmin": {
            "type": "boolean"
          }
        },
        "required": [
          "authenticated",
          "isAdmin"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "healthCheck",
        "tags": [
          "System"
        ],
        "summary": "Check Worker and D1 health",
        "responses": {
          "200": {
            "description": "The Worker can query D1.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "500": {
            "description": "D1 is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/posts": {
      "get": {
        "operationId": "listPosts",
        "tags": [
          "Posts"
        ],
        "summary": "List posts, or return every post of one Asia/Shanghai date",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": false,
            "name": "cursor",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Start at the end of this Asia/Shanghai date and page toward older posts. Mutually exclusive with cursor and date.",
              "example": "2026-08-07"
            },
            "required": false,
            "description": "Start at the end of this Asia/Shanghai date and page toward older posts. Mutually exclusive with cursor and date.",
            "name": "anchorDate",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Return every post of this Asia/Shanghai date plus adjacent-date navigation, ignoring limit. Mutually exclusive with cursor and anchorDate.",
              "example": "2026-08-07"
            },
            "required": false,
            "description": "Return every post of this Asia/Shanghai date plus adjacent-date navigation, ignoring limit. Mutually exclusive with cursor and anchorDate.",
            "name": "date",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "A newest-first cursor page, or a full day with navigation in date mode.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostList"
                }
              }
            }
          },
          "400": {
            "description": "Invalid pagination cursor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "The requested date has no posts.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid query parameters.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createPost",
        "tags": [
          "Posts"
        ],
        "summary": "Create a post",
        "security": [
          {
            "ClerkBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WritePost"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Post created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Administrator access required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Authentication is not configured.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/statistics": {
      "get": {
        "operationId": "getMomentStatistics",
        "tags": [
          "Statistics"
        ],
        "summary": "Get daily post counts and a rendered administrator narrative",
        "security": [
          {
            "ClerkBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Daily counts and a structured administrator narrative computed in Asia/Shanghai.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MomentStatistics"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Administrator access required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Authentication is not configured.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/statistics/rebuild": {
      "post": {
        "operationId": "rebuildMomentStatistics",
        "tags": [
          "Statistics"
        ],
        "summary": "Recompute statistics aggregates from the posts table",
        "security": [
          {
            "ClerkBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Fresh statistics after the rebuild.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MomentStatistics"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Administrator access required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Authentication is not configured.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/random": {
      "get": {
        "operationId": "getRandomMomentDate",
        "tags": [
          "Posts"
        ],
        "summary": "Pick a random post and return every post from its date",
        "responses": {
          "200": {
            "description": "The randomly selected Asia/Shanghai date and its posts.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostList"
                }
              }
            }
          },
          "404": {
            "description": "There are no posts to pick.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/posts/{id}": {
      "get": {
        "operationId": "getPostById",
        "tags": [
          "Posts"
        ],
        "summary": "Get a post and its adjacent post IDs",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Stable post ID.",
              "example": "b3d4da0e-9d8d-43ee-a6a2-c0139814d59e"
            },
            "required": true,
            "description": "Stable post ID.",
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Post detail.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostDetail"
                }
              }
            }
          },
          "404": {
            "description": "Post not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid post ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updatePost",
        "tags": [
          "Posts"
        ],
        "summary": "Update a post",
        "security": [
          {
            "ClerkBearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Stable post ID.",
              "example": "b3d4da0e-9d8d-43ee-a6a2-c0139814d59e"
            },
            "required": true,
            "description": "Stable post ID.",
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WritePost"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Post updated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Administrator access required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Post not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Authentication is not configured.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deletePost",
        "tags": [
          "Posts"
        ],
        "summary": "Soft-delete a post",
        "security": [
          {
            "ClerkBearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Stable post ID.",
              "example": "b3d4da0e-9d8d-43ee-a6a2-c0139814d59e"
            },
            "required": true,
            "description": "Stable post ID.",
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "Post moved to the recycle bin."
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Administrator access required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Post not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid post ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Authentication is not configured.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
