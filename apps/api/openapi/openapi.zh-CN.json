{
  "openapi": "3.1.0",
  "info": {
    "title": "Moments API（中文）",
    "version": "2.0.0",
    "description": "Moments 个人内容站点 API：公开读取，写操作由 Clerk 管理员鉴权保护。v2 将日期读取合并进 GET /posts（?date=），统计改由增量聚合表提供。"
  },
  "servers": [
    {
      "url": "http://localhost:8787",
      "description": "本地 Wrangler 开发服务器；导入后可改为线上 API 地址。"
    }
  ],
  "tags": [
    {
      "name": "系统",
      "description": "服务元数据与健康状态。"
    },
    {
      "name": "内容",
      "description": "公开读取内容，以及管理员创建、编辑和删除内容。"
    },
    {
      "name": "日期",
      "description": "按亚洲/上海日期读取内容并导航。"
    },
    {
      "name": "统计",
      "description": "每日发布统计与管理员统计文案。"
    },
    {
      "name": "回收站",
      "description": "管理员查看、恢复和永久删除内容。"
    },
    {
      "name": "身份认证",
      "description": "Clerk 会话与管理员状态。"
    }
  ],
  "components": {
    "securitySchemes": {
      "ClerkBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Clerk 会话 JWT",
        "description": "Clerk getToken() 返回的会话令牌。请在请求头中填写 Authorization: Bearer <token>。"
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "description": "Worker 健康状态。"
          },
          "database": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "description": "D1 数据库健康状态。"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "服务器生成响应时的 ISO 8601 时间。"
          }
        },
        "required": [
          "status",
          "database",
          "timestamp"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "message"
                  ]
                }
              }
            },
            "required": [
              "code",
              "message"
            ],
            "description": "错误信息。"
          },
          "requestId": {
            "type": "string",
            "format": "uuid",
            "description": "用于日志追踪的请求 UUID。"
          }
        },
        "required": [
          "error",
          "requestId"
        ]
      },
      "PostList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Post"
            },
            "description": "当前页内容列表。"
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "下一页游标；没有更多内容时为 null。日期模式下恒为 null。"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "仅在日期模式（?date=）下返回：请求的亚洲/上海日期。",
            "example": "2026-08-07"
          },
          "navigation": {
            "type": "object",
            "properties": {
              "newerDate": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "固定亚洲/上海时区的日历日期，格式为 YYYY-MM-DD。",
                "example": "2026-08-07"
              },
              "olderDate": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "固定亚洲/上海时区的日历日期，格式为 YYYY-MM-DD。",
                "example": "2026-08-07"
              }
            },
            "required": [
              "newerDate",
              "olderDate"
            ],
            "description": "仅在日期模式（?date=）下返回：相邻有内容日期的导航信息。"
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "Post": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "稳定的内容 UUID。",
            "example": "b3d4da0e-9d8d-43ee-a6a2-c0139814d59e"
          },
          "content": {
            "type": "string",
            "example": "今天完成了 Moments API。",
            "description": "规范化后的正文。图片内容允许为空字符串。"
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "description": "内容所附的有序图片 URL 列表。",
            "example": [
              "https://file.example.com/file/example.jpg"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "创建时间，ISO 8601 格式。"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "最后更新时间，ISO 8601 格式。"
          },
          "edited": {
            "type": "boolean",
            "description": "内容是否在创建后编辑过。"
          }
        },
        "required": [
          "id",
          "content",
          "images",
          "createdAt",
          "updatedAt",
          "edited"
        ]
      },
      "MomentStatistics": {
        "type": "object",
        "properties": {
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DailyMomentCount"
            },
            "description": "按亚洲/上海日期统计的每日发布数量。"
          },
          "administratorNarrative": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NarrativeParagraph"
            },
            "description": "后端生成的结构化管理员统计文案。"
          }
        },
        "required": [
          "days",
          "administratorNarrative"
        ]
      },
      "DailyMomentCount": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "亚洲/上海日历日期。",
            "example": "2026-08-07"
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "description": "当天发布且未删除的内容数量。"
          }
        },
        "required": [
          "date",
          "count"
        ]
      },
      "NarrativeParagraph": {
        "type": "object",
        "properties": {
          "segments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NarrativeSegment"
            },
            "minItems": 1,
            "description": "该段落包含的文本片段。"
          }
        },
        "required": [
          "segments"
        ]
      },
      "NarrativeSegment": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "文本内容。"
          },
          "bold": {
            "type": "boolean",
            "default": false,
            "description": "前端是否应以粗体渲染该片段。"
          }
        },
        "required": [
          "text"
        ]
      },
      "PostDetail": {
        "type": "object",
        "properties": {
          "post": {
            "$ref": "#/components/schemas/Post",
            "description": "内容正文与元数据。"
          },
          "navigation": {
            "type": "object",
            "properties": {
              "newerId": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uuid",
                "description": "稳定的内容 UUID。",
                "example": "b3d4da0e-9d8d-43ee-a6a2-c0139814d59e"
              },
              "olderId": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uuid",
                "description": "稳定的内容 UUID。",
                "example": "b3d4da0e-9d8d-43ee-a6a2-c0139814d59e"
              }
            },
            "required": [
              "newerId",
              "olderId"
            ],
            "description": "相邻公开内容的 ID。"
          }
        },
        "required": [
          "post",
          "navigation"
        ]
      },
      "WritePost": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "default": "",
            "description": "正文；保存前会规范化连续空格、制表符和换行。"
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "maxItems": 18,
            "default": [],
            "description": "有序图片 URL 列表，最多 18 张；正文和图片至少提供一项。"
          }
        },
        "additionalProperties": false
      },
      "DeletePostImage": {
        "type": "object",
        "properties": {
          "imageUrl": {
            "type": "string",
            "format": "uri",
            "description": "要删除的托管图片完整 URL。",
            "example": "https://file.example.com/file/moments/example.jpg"
          }
        },
        "required": [
          "imageUrl"
        ],
        "additionalProperties": false
      },
      "DeletedPostList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeletedPost"
            },
            "description": "当前页回收站内容列表。"
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "下一页游标；没有更多内容时为 null。"
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "DeletedPost": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Post"
          },
          {
            "type": "object",
            "properties": {
              "deletedAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "deletedAt"
            ]
          }
        ]
      },
      "AuthStatus": {
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean",
            "enum": [
              true
            ],
            "description": "令牌是否已通过认证；成功响应固定为 true。"
          },
          "isAdmin": {
            "type": "boolean",
            "description": "当前 Clerk 用户是否为配置的管理员。"
          }
        },
        "required": [
          "authenticated",
          "isAdmin"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "healthCheck",
        "tags": [
          "系统"
        ],
        "summary": "检查 Worker 与 D1 健康状态",
        "responses": {
          "200": {
            "description": "Worker 可以正常查询 D1。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "500": {
            "description": "D1 当前不可用。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/posts": {
      "get": {
        "operationId": "listPosts",
        "tags": [
          "内容"
        ],
        "summary": "分页获取内容列表，或返回某个亚洲/上海日期下的全部内容",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": false,
            "name": "cursor",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "从该亚洲/上海日期的末尾开始向更早内容分页；不能与 cursor 或 date 同时使用。",
              "example": "2026-08-07"
            },
            "required": false,
            "description": "从该亚洲/上海日期的末尾开始向更早内容分页；不能与 cursor 或 date 同时使用。",
            "name": "anchorDate",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "返回该亚洲/上海日期下的全部内容及相邻日期导航，忽略 limit；不能与 cursor 或 anchorDate 同时使用。",
              "example": "2026-08-07"
            },
            "required": false,
            "description": "返回该亚洲/上海日期下的全部内容及相邻日期导航，忽略 limit；不能与 cursor 或 anchorDate 同时使用。",
            "name": "date",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "按创建时间从新到旧排列的游标分页结果；日期模式下返回当天全部内容及导航。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostList"
                }
              }
            }
          },
          "400": {
            "description": "分页游标无效。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "请求的日期没有内容。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "查询参数无效。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "服务器发生意外错误。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createPost",
        "tags": [
          "内容"
        ],
        "summary": "创建内容",
        "security": [
          {
            "ClerkBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WritePost"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "内容创建成功。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post"
                }
              }
            }
          },
          "401": {
            "description": "需要登录。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "需要管理员权限。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "请求体无效。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "服务器发生意外错误。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "身份认证尚未配置。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/statistics": {
      "get": {
        "operationId": "getMomentStatistics",
        "tags": [
          "统计"
        ],
        "summary": "获取每日发布数量与管理员统计文案",
        "security": [
          {
            "ClerkBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "按亚洲/上海时区计算的每日数量和结构化管理员统计文案。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MomentStatistics"
                }
              }
            }
          },
          "401": {
            "description": "需要登录。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "需要管理员权限。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "服务器发生意外错误。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "身份认证尚未配置。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/statistics/rebuild": {
      "post": {
        "operationId": "rebuildMomentStatistics",
        "tags": [
          "统计"
        ],
        "summary": "从 posts 表重新计算统计聚合数据",
        "security": [
          {
            "ClerkBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "重建后的最新统计信息。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MomentStatistics"
                }
              }
            }
          },
          "401": {
            "description": "需要登录。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "需要管理员权限。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "服务器发生意外错误。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "身份认证尚未配置。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/random": {
      "get": {
        "operationId": "getRandomMomentDate",
        "tags": [
          "内容"
        ],
        "summary": "随机选择一篇内容并返回当天的全部内容",
        "responses": {
          "200": {
            "description": "随机选中的亚洲/上海日期及当天内容。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostList"
                }
              }
            }
          },
          "404": {
            "description": "当前没有可供随机选择的内容。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "服务器发生意外错误。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/rss.xml": {
      "get": {
        "operationId": "getRecentMomentsRss",
        "tags": [
          "内容"
        ],
        "summary": "获取最近 20 个亚洲/上海自然日的 RSS 2.0 订阅源",
        "responses": {
          "200": {
            "description": "包含公开内容的 RSS 2.0 XML 文档。",
            "content": {
              "application/rss+xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "服务器发生意外错误。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/posts/{id}": {
      "get": {
        "operationId": "getPostById",
        "tags": [
          "内容"
        ],
        "summary": "获取单篇内容及相邻内容 ID",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "稳定的内容 UUID。",
              "example": "b3d4da0e-9d8d-43ee-a6a2-c0139814d59e"
            },
            "required": true,
            "description": "稳定的内容 UUID。",
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "内容详情。",
