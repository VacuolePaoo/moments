{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "moment-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGIN": "https://moment.vacu.top",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moments",
      "database_id": "fa855adc-7844-4220-9035-d4cbc7b54e1b",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
    },
  },
}
